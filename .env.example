# Database Configuration (PostgreSQL 16 with btree_gist + pgvector)
DATABASE_URL=postgresql://epfo_admin:epfo_secure_password_2026@localhost:5432/epfo_intelligence

# Redis Caching & Celery Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# MinIO S3 Document Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secure_2026
MINIO_BUCKET=epfo-documents

# Security & Tenant Authentication
JWT_SECRET=epfo_production_jwt_secret_key_change_me_2026
ADMIN_API_KEY=epfo-admin-key-2026

# Autonomous Schedule Times (IST)
INGEST_SWEEP_CRON="0 6 * * *"
SHADOW_GATE_CRON="15 6 * * *"
CACHE_DECAY_CRON="30 6 * * *"
